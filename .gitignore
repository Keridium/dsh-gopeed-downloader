# -- Dependencies -------------------------------------------------------------
# The most important rule: node_modules/ must NEVER enter the repository.
# The @deepseek-ai/schemastery and @deepseek-ai/cosmokit copies in this directory
# exist only for "link:" installs (copyright DSH / the original authors).
# A public repository gets them from the profile's own dependencies; anyone who
# clones this repo follows the README instead.
node_modules/

# Package artifacts (npm pack / hand-made release archives)
*.tgz
*.tar.gz

# -- Runtime and debugging ----------------------------------------------------
# Plugin runtime logs and the diagnostic logs written by the DSH plugin manager
*.log
logs/
.plugin-manager/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# -- Operating system ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -- Editors ------------------------------------------------------------------
# Note: .vscode/ is ignored as a whole directory here.
# Reason: editor settings differ from person to person and easily record absolute
# local paths or debug launch entries; if there really is something worth sharing
# (a recommended-extensions list, for example), whitelist it instead, for example
# `.vscode/extensions.json`:
#   !.vscode/extensions.json
.vscode/
.idea/
*.code-workspace

# -- Lock files ---------------------------------------------------------------
# Trade-off: this package is a library-style plugin (no build step, no
# devDependencies, no runtime dependencies), so a lock file does not help the
# reproducibility of this package itself; it would only drag the maintainer's
# local resolution result (registry / integrity data included) into the
# repository. It is therefore ignored by default.
#
# If you would rather have "clone, then pnpm install and get exactly the same
# dependency tree", delete the three lines below and commit exactly one kind of
# lock file -- but only one, and never the lock content produced by a link:
# install.
#   package-lock.json   # npm
#   pnpm-lock.yaml      # pnpm (the manager DSH ships with uses it)
#   yarn.lock           # yarn
package-lock.json
pnpm-lock.yaml
yarn.lock

# -- Miscellaneous ------------------------------------------------------------
# Directory used locally for drafts and screenshots during development
scratch/
*.local
.env
.env.*
