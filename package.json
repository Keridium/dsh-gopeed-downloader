{
  "name": "dsh-gopeed",
  "version": "0.1.1",
  "private": false,
  "description": "DSH plugin that turns a local Gopeed downloader into agent tools (add, list, pause, resume, remove) with a configurable host, port and API token.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/api.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "gopeed",
    "downloader",
    "agent-tool",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keridium/dsh-gopeed.git"
  },
  "homepage": "https://github.com/Keridium/dsh-gopeed#readme",
  "bugs": {
    "url": "https://github.com/Keridium/dsh-gopeed/issues"
  },
  "author": "Keridium (https://github.com/Keridium)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
