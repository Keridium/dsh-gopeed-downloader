{
  "name": "dsh-gopeed-downloader",
  "version": "0.3.2",
  "private": false,
  "description": "Agent tools for a local Gopeed downloader: create, inspect, pause, resume and remove downloads; diagnose or launch the Gopeed process; and receive download-complete events, including a background job that can wake an idle agent. The REST tools are cross-platform; process control is Windows-only.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/api.js",
    "lib/webhook.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "gopeed",
    "downloader",
    "agent-tool",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keridium/dsh-gopeed-downloader.git"
  },
  "homepage": "https://github.com/Keridium/dsh-gopeed-downloader#readme",
  "bugs": {
    "url": "https://github.com/Keridium/dsh-gopeed-downloader/issues"
  },
  "author": "Keridium (https://github.com/Keridium)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
